# Bright Data CLI auth is handled by `bdata login` (stored in the CLI's own config) — no token needed here.

# AI (Google Gemini, gemini-3.5-flash-lite) — advisory anomaly second-pass,
# AI-written heal diagnoses, and the weekly digest summary. Get a free-tier key at
# https://aistudio.google.com/apikey. On by default; leave this blank and it
# falls back to pure rule-based automatically (no key = no AI calls, regardless
# of the on/off toggle). The toggle itself isn't an env var — it's runtime
# state, set with `flank ai on` / `flank ai off` (persisted to
# collectors/ai-state.json, not .env, so it takes effect immediately without
# restarting a running dashboard).
GEMINI_API_KEY=

FLANKWATCH_DB_PATH=
